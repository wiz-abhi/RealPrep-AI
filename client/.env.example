# ===========================================
# RealPrep AI - Client Environment Variables
# ===========================================

# ===========================================
# Speech Provider Configuration
# ===========================================

# Default Speech Provider: 'sarvam' (default, server-proxied) or 'azure'
# Sarvam needs no client-side key — the server proxies STT/TTS with its key.
VITE_DEFAULT_SPEECH_PROVIDER="sarvam"

# Azure Speech API (only needed if using the 'azure' provider)
# Get from: https://portal.azure.com → Create Speech Service
VITE_AZURE_SPEECH_KEY=""
VITE_AZURE_SPEECH_REGION=""

# ===========================================
# Other API Keys
# ===========================================

# Hume AI API Key (for emotion analysis - optional, can use server-side)
# Get it from: https://platform.hume.ai/settings/keys
VITE_HUME_API_KEY=""

# ===========================================
# Deployment Configuration (Production Only)
# ===========================================

# Backend API URL (set this in production)
# Example: https://realprep-ai-server.onrender.com
VITE_API_URL=""
