# ===========================================
# RealPrep AI - Server Environment Variables
# ===========================================

# Database Connection (PostgreSQL with pgvector)
DATABASE_URL="postgresql://username:password@localhost:5432/realprep_ai?schema=public"

# JWT Secret for Authentication (generate a secure random string)
# In production this MUST be overridden — the server refuses to start otherwise.
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Port
PORT=3000

# NODE_ENV=development in dev; NODE_ENV=production in prod enables strict checks.
# NODE_ENV=development

# ===========================================
# AI Service API Keys
# ===========================================

# Sarvam AI API Key — powers the LLM (interview chat + reports + improvement plans)
# and optionally speech (STT via Saaras, TTS via Bulbul).
# Get it from: https://dashboard.sarvam.ai
SARVAM_API_KEY="sk_your_sarvam_api_key"

# Optional Sarvam model overrides. Defaults are shown.
# - sarvam-30b: 64K context, faster; used for live interview turns
# - sarvam-105b: 128K context, slower/higher quality; used for reports & plans
SARVAM_CHAT_MODEL="sarvam-30b"
SARVAM_REPORT_MODEL="sarvam-105b"
# SARVAM_MAX_TOKENS="4000"          # per-request cap (starter tier max: 4096)
# SARVAM_STT_MODEL="saarika:v2.5"   # streaming STT model

# Razorpay (required for credit purchases — /api/payment 500s without them)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional: self-hosted code-execution endpoint (defaults to public Piston)
# PISTON_URL="https://emkc.org/api/v2/piston/execute"

# (No Hume keys needed server-side — emotion detection is handled entirely
#  by the client via VITE_HUME_API_KEY in client/.env)

# ===========================================
# Email (SMTP) — used for password reset links
# If unset, reset links are logged to the server console instead (dev mode).
# ===========================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RealPrep AI <no-reply@realprep.ai>"

# ===========================================
# Deployment Configuration (Production Only)
# ===========================================

# Frontend URL for CORS (set this in production)
# Example: https://realprep-ai.vercel.app
FRONTEND_URL=""
